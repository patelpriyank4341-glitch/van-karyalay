# આ ફાઈલની નકલ કરી ".env" નામથી સેવ કરો, અને નીચેની વેલ્યુ ભરો.
# Render.com પર Environment Variables તરીકે આ જ નામથી ઉમેરવાના રહેશે.

# PostgreSQL database ની કનેક્શન સ્ટ્રિંગ (Render/Supabase/Railway પર Postgres બનાવો ત્યારે મળે છે)
DATABASE_URL=postgres://username:password@host:5432/dbname

# JWT ટોકન સહી કરવા માટે કોઈ પણ લાંબો, રેન્ડમ, ગુપ્ત શબ્દસમૂહ (કોઈને ના જણાવવો)
JWT_SECRET=change-this-to-a-long-random-secret-string

# પ્રથમ વખત સર્વર શરૂ થાય ત્યારે બનનાર Admin લોગિન (પછી એપ્લિકેશનમાંથી બદલી શકાશે નહીં —
# password બદલવા માટે ડેટાબેઝ સીધો અપડેટ કરવો પડશે, તેથી મજબૂત પાસવર્ડ રાખો)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123

# સર્વર પોર્ટ (Render આપમેળે PORT આપે છે, લોકલ ટેસ્ટિંગ માટે 4000 રાખો)
PORT=4000
